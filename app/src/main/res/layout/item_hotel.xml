<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="6dp"
        android:background="@drawable/item_background"
        android:elevation="4dp"
        android:translationZ="2dp">

    <ImageView
            android:id="@+id/hotel_image"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:contentDescription="Изображение отеля" />

    <TextView
            android:id="@+id/hotel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Название отеля"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:maxLines="2"
            android:ellipsize="end" />

    <TextView
            android:id="@+id/hotel_secondary_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Район"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:visibility="gone" />

    <TextView
            android:id="@+id/hotel_primary_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Основная информация"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:visibility="gone" />

    <TextView
            android:id="@+id/hotel_bubble_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Рейтинг: 0.0"
            android:textSize="14sp"
            android:textColor="@color/black" />

    <TextView
            android:id="@+id/hotel_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Цена: $100"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:visibility="gone" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
                android:id="@+id/view_all_deals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Открыть на TripAdvisor"
                android:textColor="@color/darkblue"
                android:textSize="16sp"
                android:visibility="gone" />

        <TextView
                android:id="@+id/event_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Подробнее"
                android:textColor="@color/darkblue"
                android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>